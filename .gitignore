.idea/
*.swp
*.swo
*~
.vs/

# =============================================
# SUPABASE
# =============================================
supabase/.temp/
supabase/.branches/
supabase/.migrations/

# =============================================
# REPORTS (EXTERNAL DDK APP ONLY)
# =============================================
# Only ignore the reports folder at the root level, not your React components!
/reports/
# Ignore common report file types ONLY inside that root reports folder
/reports/*.html
/reports/*.json
/reports/*.csv
/reports/*.pdf

# =============================================
# PYTHON (for DDK launcher)
# =============================================
