.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
.env.staging

# =============================================
# DEPENDENCIES
# =============================================
node_modules/
.pnpm-store/
yarn-error.log
# DO NOT ignore package-lock.json or pnpm-lock.yaml! GitHub Actions needs them.

